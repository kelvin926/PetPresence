<Window x:Class="PetPresence.Desktop.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PetPresence Overlay"
        Width="900"
        Height="600"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Background="Transparent">
        <ItemsControl ItemsSource="{Binding Friends}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True" Background="Transparent" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="128"
                            Padding="8"
                            CornerRadius="16"
                            Background="#CC20242A"
                            MouseLeftButtonDown="Pet_MouseLeftButtonDown"
                            MouseLeftButtonUp="Pet_MouseLeftButtonUp"
                            MouseMove="Pet_MouseMove">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#FF8AD6FF">
                                <TextBlock Text="🐾" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <Border Margin="0,4,0,0" Padding="8,4" CornerRadius="10" Background="#EEFFFFFF">
                                <TextBlock Text="{Binding StatusText}" Foreground="#222" TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding AnimationKey}" Foreground="#B7FFFFFF" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
